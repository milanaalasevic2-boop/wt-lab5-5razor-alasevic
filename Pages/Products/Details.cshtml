@page
@model DetailsModel

@{
    ViewData["Title"] = "Подробнее о товаре";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h1 class="fw-bold mb-0">@Model.Product?.Name</h1>
                        @if (Model.Product?.IsAvailable == true)
                        {
                            <span class="badge bg-success fs-6">В наличии</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Нет в наличии</span>
                        }
                    </div>

                    <p class="text-muted mb-4">Категория: @Model.Product?.Category</p>

                    <h3 class="text-primary fw-bold mb-4">
                        @Model.Product?.Price.ToString("N0") ₽
                    </h3>

                    <hr />

                    <div class="d-flex gap-2 mt-4">
                        <a asp-page="./Edit" asp-route-id="@Model.Product?.Id" class="btn btn-warning px-4">
                            Редактировать
                        </a>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Product?.Id"
                              onsubmit="return confirm('Вы уверены, что хотите удалить этот товар?');">
                            <button type="submit" class="btn btn-danger px-4">
                                Удалить
                            </button>
                        </form>

                        <a asp-page="./Index" class="btn btn-outline-secondary ms-auto">
                            ← Назад к списку
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>