@page
@model CreateModel

@{
    ViewData["Title"] = "Добавление товара";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-4">Добавление товара</h2>

                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="Product.Name" class="form-label fw-semibold">
                                Название
                            </label>
                            <input asp-for="Product.Name" class="form-control" placeholder="Например, Ноутбук" />
                            <span asp-validation-for="Product.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Product.Category" class="form-label fw-semibold">
                                Категория
                            </label>
                            <input asp-for="Product.Category" class="form-control" placeholder="Например, Компьютеры" />
                            <span asp-validation-for="Product.Category" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Product.Price" class="form-label fw-semibold">
                                Цена, ₽
                            </label>
                            <input asp-for="Product.Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Product.Price" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Product.IsAvailable" class="form-check-input" />
                            <label asp-for="Product.IsAvailable" class="form-check-label">
                                Доступен в наличии
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary px-4">
                            Сохранить
                        </button>
                        <a asp-page="./Index" class="btn btn-secondary">
                            Назад
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}